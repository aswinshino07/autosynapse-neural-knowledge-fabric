# Leave unset for a fully deterministic, local evidence-template response.
# If set, the endpoint must be loopback-only (the backend rejects remote hosts).
LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LLAMA_CPP_MODEL=SmolLM2-360M-Instruct

# Demo never opens a CAN interface or connects to CARLA automatically.
CAN_INTERFACE=
CAN_CHANNEL=
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
